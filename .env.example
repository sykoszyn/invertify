# Supabase (opcional: sin esto la app funciona guardando en el navegador)
# Project Settings → API Keys. También se aceptan NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor: crea cuentas sin mail de confirmación. Nunca la subas al repo.
SUPABASE_SECRET_KEY=sb_secret_...

# Claude API (opcional: habilita el asesor IA y la lectura de capturas)
ANTHROPIC_API_KEY=sk-ant-...
